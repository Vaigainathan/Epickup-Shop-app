{
  "expo": {
    "name": "EPickup Shop",
    "slug": "epickup-shop",
    "version": "1.0.5",
    "versionCode": 1,
    "orientation": "portrait",
    "icon": "./assets/images/epickup_shop_logo_1024.png",
    "scheme": "epickup-shop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/epickup_shop_logo_1024.png"
    },
    "android": {
      "package": "com.epickup.shop",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/epickup_shop_logo_1024.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/epickup_shop_logo_512.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/epickup_shop_logo_1024.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "EXPO_PUBLIC_GOOGLE_MAPS_API_KEY"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow ePickup Shop to use your location to place your shop on the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ePickup Shop to access your photos for documents and catalogue images.",
          "cameraPermission": "Allow ePickup Shop to take photos of documents and catalogue items.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ePickup Shop to take photos of documents and catalogue items.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#000666",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4e5056b2-81c8-4384-8082-a25c861b7590"
      }
    },
    "owner": "vaigainathan"
  }
}
