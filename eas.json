{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://epickupbackend-staging.up.railway.app",
        "APP_ENV": "staging"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://epickupbackend-staging.up.railway.app",
        "APP_ENV": "staging"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://epickupbackend-staging.up.railway.app",
        "APP_ENV": "staging"
      }
    }
  },
  "submit": {
    "production": {}
  }
}